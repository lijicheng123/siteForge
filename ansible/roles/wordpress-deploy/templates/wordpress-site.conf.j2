# WordPress 站点配置 - 高性能 + SSL 支持
# 网站: {{ site_domain }}
# 生成时间: {{ ansible_date_time.iso8601 }}

{% if ssl.enabled %}
# HTTP 重定向到 HTTPS (SSL启用时)
server {
    listen 80;
    listen [::]:80;
    server_name {{ site_domain }}{% if site_aliases is defined %} {{ site_aliases | join(' ') }}{% endif %};
    
    # Let's Encrypt ACME 挑战
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri $uri/ =404;
    }
    
    # 其他请求重定向到 HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}
{% endif %}

# 主服务器配置 ({{ 'HTTPS' if ssl.enabled else 'HTTP' }})
server {
    {% if ssl.enabled %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    {% else %}
    listen 80;
    listen [::]:80;
    {% endif %}
    
    server_name {{ site_domain }}{% if site_aliases is defined %} {{ site_aliases | join(' ') }}{% endif %};
    root /var/www/html;
    index index.php index.html index.htm;
    
    # 访问和错误日志
    access_log /var/log/nginx/{{ project_name }}_access.log main;
    error_log /var/log/nginx/{{ project_name }}_error.log warn;
    
    {% if ssl.enabled %}
    # SSL 配置
    ssl_certificate {{ ssl.cert_path | default('/etc/letsencrypt/live/' + site_domain + '/fullchain.pem') }};
    ssl_certificate_key {{ ssl.key_path | default('/etc/letsencrypt/live/' + site_domain + '/privkey.pem') }};
    
    # SSL 优化设置
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    
    # 现代 SSL 配置 (Mozilla Intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    
    # HSTS (HTTP Strict Transport Security)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    
    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate {{ ssl.cert_path | default('/etc/letsencrypt/live/' + site_domain + '/chain.pem') }};
    {% endif %}
    
    # WordPress 安全配置
    location = /favicon.ico {
        log_not_found off;
        access_log off;
        expires max;
        add_header Cache-Control "public, immutable";
    }
    
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
        expires 1d;
        add_header Cache-Control "public";
    }
    
    # 拒绝访问敏感文件
    location ~* \.(htaccess|htpasswd|ini|log|sh|sql|conf)$ {
        deny all;
        return 404;
    }
    
    location ~* /\.(?!well-known\/) {
        deny all;
        return 404;
    }
    
    # 拒绝访问 WordPress 敏感目录
    location ~* ^/(wp-config\.php|wp-admin/install\.php|readme\.html|license\.txt) {
        deny all;
        return 404;
    }
    
    # WordPress 管理区域限速
    location ~* ^/(wp-admin|wp-login\.php) {
        limit_req zone=wpadmin burst=3 nodelay;
        try_files $uri $uri/ /index.php?$args;
        
        # 传递给 WordPress
        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass wordpress_backend;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            
            # PHP 设置
            fastcgi_param PHP_VALUE "upload_max_filesize={{ php.upload_max_filesize | default('64M') }}";
            fastcgi_param PHP_VALUE "post_max_size={{ php.post_max_size | default('64M') }}";
            fastcgi_param PHP_VALUE "max_execution_time={{ php.max_execution_time | default('300') }}";
            fastcgi_param PHP_VALUE "max_input_time={{ php.max_input_time | default('300') }}";
            
            # 禁用管理区域缓存
            fastcgi_cache_bypass 1;
            fastcgi_no_cache 1;
        }
    }
    
    # WordPress API 限速
    location ~ ^/wp-json/ {
        limit_req zone=api burst=10 nodelay;
        try_files $uri $uri/ /index.php?$args;
        
        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass wordpress_backend;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            
            # API 缓存策略
            {% if cache.api_enabled | default(true) %}
            fastcgi_cache WORDPRESS;
            fastcgi_cache_valid 200 301 302 10m;
            fastcgi_cache_valid 404 1m;
            fastcgi_cache_bypass $http_pragma $http_authorization;
            add_header X-FastCGI-Cache $upstream_cache_status;
            {% endif %}
        }
    }
    
    # 静态文件优化
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Vary Accept-Encoding;
        
        # 启用 Gzip 压缩
        gzip_static on;
        
        # 尝试直接提供文件，如果不存在则传递给 PHP
        try_files $uri @php;
        
        # 日志优化
        access_log off;
        log_not_found off;
    }
    
    # 媒体文件
    location ~* \.(mp4|mp3|avi|mov|flv|wmv|asf|asx|mpg|mpeg|mpe)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
        log_not_found off;
        
        try_files $uri @php;
    }
    
    # WordPress 主要路由
    location / {
        try_files $uri $uri/ @php;
    }
    
    # PHP 处理 (命名location，被其他location引用)
    location @php {
        rewrite ^(.*)$ /index.php?$args last;
    }
    
    # PHP 文件处理
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass wordpress_backend;
        fastcgi_index index.php;
        
        # FastCGI 参数
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_param REQUEST_METHOD $request_method;
        fastcgi_param CONTENT_TYPE $content_type;
        fastcgi_param CONTENT_LENGTH $content_length;
        
        # HTTPS 检测
        {% if ssl.enabled %}
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
        {% else %}
        fastcgi_param SERVER_PORT 80;
        {% endif %}
        
        # 性能调优
        fastcgi_connect_timeout 60s;
        fastcgi_send_timeout 180s;
        fastcgi_read_timeout 180s;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 256 16k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;
        fastcgi_max_temp_file_size 0;
        
        {% if cache.enabled | default(true) %}
        # FastCGI 缓存配置
        set $no_cache 0;
        
        # 不缓存的条件
        if ($request_method = POST) {
            set $no_cache 1;
        }
        if ($query_string != "") {
            set $no_cache 1;
        }
        if ($request_uri ~* "/(wp-admin|wp-json|wp-login|wp-register|wp-cron|xmlrpc)") {
            set $no_cache 1;
        }
        if ($http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in") {
            set $no_cache 1;
        }
        
        # 缓存设置
        fastcgi_cache WORDPRESS;
        fastcgi_cache_valid 200 301 302 {{ cache.valid_time | default('10m') }};
        fastcgi_cache_valid 404 {{ cache.not_found_time | default('1m') }};
        fastcgi_cache_bypass $no_cache;
        fastcgi_no_cache $no_cache;
        
        # 缓存头部
        add_header X-FastCGI-Cache $upstream_cache_status;
        {% endif %}
    }
    
    # 健康检查端点
    location = /health-check {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
    
    # Nginx 状态页面 (仅本地访问)
    location = /nginx_status {
        stub_status on;
        access_log off;
        allow 127.0.0.1;
        allow 172.20.0.0/16;  # Docker 网络
        deny all;
    }
    
    # 防止直接访问上传的 PHP 文件
    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
        return 404;
    }
    
    # XML-RPC 防护 (如果不需要可以完全禁用)
    location = /xmlrpc.php {
        {% if xmlrpc.enabled | default(false) %}
        limit_req zone=api burst=3 nodelay;
        include fastcgi_params;
        fastcgi_pass wordpress_backend;
        {% else %}
        deny all;
        return 404;
        {% endif %}
    }
}
