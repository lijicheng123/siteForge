#!/bin/bash
# WordPress 智能备份脚本 v2.0
# 生成时间: {{ ansible_date_time.iso8601 }}
# 项目: {{ project_name }}

set -euo pipefail

# =============================================================================
# 配置变量
# =============================================================================
PROJECT_DIR="{{ project_dir }}"
PROJECT_NAME="{{ project_name }}"
BACKUP_DIR="{{ project_dir }}/backups"
BACKUP_RETENTION_DAYS={{ backup.retention_days | default('7') }}
LOG_FILE="{{ project_dir }}/logs/backup.log"

# 数据库配置
DB_NAME="{{ wordpress.db_name }}"
DB_USER="{{ wordpress.db_user }}"
DB_PASS="{{ wordpress.db_password }}"
DB_ROOT_PASS="{{ mysql_root_password }}"

# 备份类型配置
BACKUP_DATABASE={{ backup.database_enabled | default('true') }}
BACKUP_FILES={{ backup.files_enabled | default('true') }}
BACKUP_CONFIG={{ backup.config_enabled | default('true') }}
COMPRESS_BACKUPS={{ backup.compress | default('true') }}

# 云存储配置 (可选)
{% if backup.cloud_storage.enabled | default(false) %}
CLOUD_STORAGE_ENABLED=true
CLOUD_PROVIDER="{{ backup.cloud_storage.provider | default('s3') }}"
CLOUD_BUCKET="{{ backup.cloud_storage.bucket }}"
CLOUD_REGION="{{ backup.cloud_storage.region | default('us-east-1') }}"
{% else %}
CLOUD_STORAGE_ENABLED=false
{% endif %}

# 通知配置 (可选)
{% if backup.notifications.enabled | default(false) %}
NOTIFY_ENABLED=true
NOTIFY_EMAIL="{{ backup.notifications.email }}"
NOTIFY_WEBHOOK="{{ backup.notifications.webhook | default('') }}"
{% else %}
NOTIFY_ENABLED=false
{% endif %}

# =============================================================================
# 工具函数
# =============================================================================
log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$timestamp] [$level] $message" | tee -a "$LOG_FILE"
}

error() {
    log "ERROR" "$@"
    send_notification "FAILED" "备份失败: $*"
    exit 1
}

info() {
    log "INFO" "$@"
}

warn() {
    log "WARN" "$@"
}

# 检查依赖
check_dependencies() {
    info "检查依赖..."
    
    # 检查 Docker
    if ! command -v docker >/dev/null 2>&1; then
        error "Docker 未安装或不在 PATH 中"
    fi
    
    # 检查 Docker Compose
    if ! docker compose version >/dev/null 2>&1; then
        error "Docker Compose 未安装或不可用"
    fi
    
    # 检查项目目录
    if [[ ! -d "$PROJECT_DIR" ]]; then
        error "项目目录不存在: $PROJECT_DIR"
    fi
    
    # 确保备份目录存在
    mkdir -p "$BACKUP_DIR"/{db,files,config,logs}
    
    info "依赖检查完成"
}

# 检查服务状态
check_services() {
    info "检查服务状态..."
    
    cd "$PROJECT_DIR" || error "无法进入项目目录"
    
    # 检查容器运行状态
    local running_services
    running_services=$(docker compose ps --services --filter "status=running" 2>/dev/null || true)
    
    if [[ ! "$running_services" =~ "mysql" ]]; then
        error "MySQL 容器未运行"
    fi
    
    if [[ "$BACKUP_FILES" == "true" ]] && [[ ! "$running_services" =~ "wordpress" ]]; then
        error "WordPress 容器未运行"
    fi
    
    info "服务状态检查完成"
}

# 备份数据库
backup_database() {
    if [[ "$BACKUP_DATABASE" != "true" ]]; then
        info "跳过数据库备份 (已禁用)"
        return 0
    fi
    
    info "开始数据库备份..."
    
    local timestamp=$(date '+%Y%m%d_%H%M%S')
    local backup_file="$BACKUP_DIR/db/db_backup_$timestamp.sql"
    local temp_file="/tmp/mysql_backup_$timestamp.sql"
    
    # 执行数据库备份
    if docker compose exec -T mysql mysqldump \
        --single-transaction \
        --routines \
        --triggers \
        --lock-tables=false \
        --add-drop-table \
        --extended-insert \
        --quick \
        -u"$DB_USER" -p"$DB_PASS" \
        "$DB_NAME" > "$temp_file"; then
        
        # 移动到最终位置
        mv "$temp_file" "$backup_file"
        
        # 压缩备份 (如果启用)
        if [[ "$COMPRESS_BACKUPS" == "true" ]]; then
            gzip "$backup_file"
            backup_file="${backup_file}.gz"
        fi
        
        local file_size=$(du -h "$backup_file" | cut -f1)
        info "数据库备份完成: $backup_file (大小: $file_size)"
        
        # 验证备份文件
        if [[ ! -s "$backup_file" ]]; then
            error "数据库备份文件为空"
        fi
    else
        rm -f "$temp_file"
        error "数据库备份失败"
    fi
}

# 备份 WordPress 文件
backup_files() {
    if [[ "$BACKUP_FILES" != "true" ]]; then
        info "跳过文件备份 (已禁用)"
        return 0
    fi
    
    info "开始 WordPress 文件备份..."
    
    local timestamp=$(date '+%Y%m%d_%H%M%S')
    local backup_file="$BACKUP_DIR/files/wp_files_$timestamp.tar"
    
    # 使用临时容器备份 WordPress 文件
    if docker run --rm \
        -v "${PROJECT_NAME}_wordpress_data:/var/www/html:ro" \
        -v "$BACKUP_DIR/files:/backup" \
        busybox \
        tar cf "/backup/wp_files_$timestamp.tar" \
        -C /var/www/html \
        --exclude='wp-content/cache' \
        --exclude='wp-content/upgrade' \
        --exclude='wp-content/backup*' \
        --exclude='.tmp' \
        . ; then
        
        # 压缩备份 (如果启用)
        if [[ "$COMPRESS_BACKUPS" == "true" ]]; then
            gzip "$backup_file"
            backup_file="${backup_file}.gz"
        fi
        
        local file_size=$(du -h "$backup_file" | cut -f1)
        info "WordPress 文件备份完成: $backup_file (大小: $file_size)"
        
        # 验证备份文件
        if [[ ! -s "$backup_file" ]]; then
            error "WordPress 文件备份为空"
        fi
    else
        error "WordPress 文件备份失败"
    fi
}

# 备份配置文件
backup_config() {
    if [[ "$BACKUP_CONFIG" != "true" ]]; then
        info "跳过配置备份 (已禁用)"
        return 0
    fi
    
    info "开始配置文件备份..."
    
    local timestamp=$(date '+%Y%m%d_%H%M%S')
    local backup_file="$BACKUP_DIR/config/config_backup_$timestamp.tar"
    
    # 备份重要配置文件
    if tar cf "$backup_file" \
        -C "$PROJECT_DIR" \
        --exclude='logs/*' \
        --exclude='data/*' \
        --exclude='backups/*' \
        --exclude='ssl/private/*' \
        docker-compose.yml \
        config/ \
        ssl/ \
        2>/dev/null; then
        
        # 压缩备份 (如果启用)
        if [[ "$COMPRESS_BACKUPS" == "true" ]]; then
            gzip "$backup_file"
            backup_file="${backup_file}.gz"
        fi
        
        local file_size=$(du -h "$backup_file" | cut -f1)
        info "配置文件备份完成: $backup_file (大小: $file_size)"
    else
        warn "配置文件备份失败或部分失败"
    fi
}

# 清理旧备份
cleanup_old_backups() {
    info "清理 $BACKUP_RETENTION_DAYS 天前的旧备份..."
    
    local deleted_count=0
    
    # 清理各类备份文件
    for backup_type in db files config; do
        local backup_path="$BACKUP_DIR/$backup_type"
        if [[ -d "$backup_path" ]]; then
            while IFS= read -r -d '' file; do
                rm -f "$file"
                ((deleted_count++))
            done < <(find "$backup_path" -type f -mtime +$BACKUP_RETENTION_DAYS -print0 2>/dev/null)
        fi
    done
    
    if [[ $deleted_count -gt 0 ]]; then
        info "已删除 $deleted_count 个旧备份文件"
    else
        info "没有需要清理的旧备份文件"
    fi
}

# 上传到云存储 (可选)
upload_to_cloud() {
    if [[ "$CLOUD_STORAGE_ENABLED" != "true" ]]; then
        return 0
    fi
    
    info "开始上传备份到云存储..."
    
    # 这里需要根据实际的云存储提供商实现上传逻辑
    # 示例: AWS S3
    if [[ "$CLOUD_PROVIDER" == "s3" ]]; then
        if command -v aws >/dev/null 2>&1; then
            # 上传最新的备份文件
            local latest_files
            latest_files=$(find "$BACKUP_DIR" -type f -mtime -1 -name "*$(date '+%Y%m%d')*")
            
            for file in $latest_files; do
                local s3_key="wordpress-backups/${PROJECT_NAME}/$(basename "$file")"
                if aws s3 cp "$file" "s3://$CLOUD_BUCKET/$s3_key" --region "$CLOUD_REGION"; then
                    info "已上传 $file 到 S3"
                else
                    warn "上传 $file 到 S3 失败"
                fi
            done
        else
            warn "AWS CLI 未安装，跳过云存储上传"
        fi
    fi
}

# 发送通知
send_notification() {
    if [[ "$NOTIFY_ENABLED" != "true" ]]; then
        return 0
    fi
    
    local status="$1"
    local message="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    # 邮件通知
    if [[ -n "$NOTIFY_EMAIL" ]] && command -v mail >/dev/null 2>&1; then
        {
            echo "WordPress 备份通知"
            echo "=================="
            echo "时间: $timestamp"
            echo "项目: $PROJECT_NAME"
            echo "状态: $status"
            echo "消息: $message"
            echo ""
            echo "服务器: $(hostname)"
            echo "备份目录: $BACKUP_DIR"
        } | mail -s "WordPress 备份通知 - $status" "$NOTIFY_EMAIL"
    fi
    
    # Webhook 通知
    if [[ -n "$NOTIFY_WEBHOOK" ]] && command -v curl >/dev/null 2>&1; then
        curl -s -X POST "$NOTIFY_WEBHOOK" \
            -H "Content-Type: application/json" \
            -d "{\"status\":\"$status\",\"message\":\"$message\",\"project\":\"$PROJECT_NAME\",\"timestamp\":\"$timestamp\"}" \
            >/dev/null || true
    fi
}

# 生成备份报告
generate_backup_report() {
    local report_file="$BACKUP_DIR/logs/backup_report_$(date '+%Y%m%d_%H%M%S').txt"
    
    {
        echo "WordPress 备份报告"
        echo "=================="
        echo "时间: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "项目: $PROJECT_NAME"
        echo ""
        
        echo "备份统计:"
        for backup_type in db files config; do
            local backup_path="$BACKUP_DIR/$backup_type"
            if [[ -d "$backup_path" ]]; then
                local count=$(find "$backup_path" -type f | wc -l)
                local size=$(du -sh "$backup_path" 2>/dev/null | cut -f1 || echo "0")
                echo "  $backup_type: $count 个文件, 总大小: $size"
            fi
        done
        
        echo ""
        echo "最近备份文件:"
        find "$BACKUP_DIR" -type f -mtime -1 -exec ls -lh {} \; | head -10
        
    } > "$report_file"
    
    info "备份报告生成: $report_file"
}

# =============================================================================
# 主流程
# =============================================================================
main() {
    local start_time=$(date '+%Y-%m-%d %H:%M:%S')
    info "========================================="
    info "开始 WordPress 备份任务"
    info "项目: $PROJECT_NAME"
    info "开始时间: $start_time"
    info "========================================="
    
    # 检查依赖和服务
    check_dependencies
    check_services
    
    # 执行备份任务
    backup_database
    backup_files  
    backup_config
    
    # 清理和上传
    cleanup_old_backups
    upload_to_cloud
    
    # 生成报告
    generate_backup_report
    
    local end_time=$(date '+%Y-%m-%d %H:%M:%S')
    local duration=$(( $(date -d "$end_time" +%s) - $(date -d "$start_time" +%s) ))
    
    info "========================================="
    info "WordPress 备份任务完成"
    info "结束时间: $end_time"
    info "总耗时: ${duration} 秒"
    info "========================================="
    
    # 发送成功通知
    send_notification "SUCCESS" "备份任务完成，耗时 ${duration} 秒"
}

# 脚本入口点
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
