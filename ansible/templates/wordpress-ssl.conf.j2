# ============================================================================
# Nginx 虚拟主机配置 - WordPress 优化版 (HTTPS Enabled)
# ============================================================================
# 域名: {{ site_domain }}
# 文档根目录: {{ wordpress_install_dir }}
# SSL 证书路径: /etc/letsencrypt/live/{{ site_domain }}/
# 生成时间: {{ ansible_date_time.iso8601 }}
# 由 SiteForge 自动生成 - 请勿手动编辑
# ============================================================================

# HTTP Server Block - 重定向到 HTTPS
server {
    listen 80;
    listen [::]:80;
    
    server_name {{ site_domain }} www.{{ site_domain }};
    
    # Let's Encrypt ACME Challenge 目录（用于证书续期）
    location ^~ /.well-known/acme-challenge/ {
        allow all;
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }
    
    # 所有其他请求重定向到 HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS Server Block (端口 443)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    
    server_name {{ site_domain }} www.{{ site_domain }};
    
    root {{ wordpress_install_dir }};
    index index.php index.html index.htm;
    
    # 访问日志和错误日志
    access_log /var/log/nginx/{{ site_domain }}/access.log;
    error_log /var/log/nginx/{{ site_domain }}/error.log warn;
    
    # 字符集
    charset utf-8;
    
    # ========================================================================
    # SSL 证书配置
    # ========================================================================
    ssl_certificate /etc/letsencrypt/live/{{ site_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site_domain }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ site_domain }}/chain.pem;
    
    # SSL 协议和加密套件配置（A+ 级别）
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    
    # SSL 会话缓存（提升性能）
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    
    # OCSP Stapling（提升 SSL 握手速度）
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;
    
    # Diffie-Hellman 参数（增强安全性）
    # ssl_dhparam /etc/nginx/dhparam.pem;  # 可选，需要手动生成
    
    # ========================================================================
    # 安全头部配置（A+ 级别）
    # ========================================================================
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "upgrade-insecure-requests" always;
    
    # ========================================================================
    # WordPress 永久链接支持
    # ========================================================================
    location / {
        try_files $uri $uri/ /index.php?$args;
    }
    
    # ========================================================================
    # PHP 处理配置 (FastCGI)
    # ========================================================================
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        
        # PHP-FPM Unix Socket 连接
        fastcgi_pass unix:/run/php-fpm/www.sock;
        fastcgi_index index.php;
        
        # FastCGI 参数
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS on;  # 告诉 PHP 当前是 HTTPS 连接
        
        # 超时设置
        fastcgi_read_timeout 300;
        fastcgi_send_timeout 300;
        
        # 缓冲区设置
        fastcgi_buffer_size 128k;
        fastcgi_buffers 256 16k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;
    }
    
    # ========================================================================
    # 静态文件缓存优化
    # ========================================================================
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # ========================================================================
    # WordPress 安全规则
    # ========================================================================
    
    # 禁止访问 wp-config.php
    location ~* wp-config.php {
        deny all;
    }
    
    # 禁止访问 .htaccess 和 .htpasswd
    location ~ /\.ht {
        deny all;
    }
    
    # 禁止访问隐藏文件（以 . 开头的文件）
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # 禁止访问 readme.html、license.txt 等敏感文件
    location ~* ^/(readme|license|changelog)\.(html|txt|md)$ {
        deny all;
    }
    
    # 禁止访问 wp-includes 目录中的 PHP 文件
    location ~* ^/wp-includes/.*\.php$ {
        deny all;
    }
    
    # 禁止访问 wp-content/uploads 目录中的 PHP 文件（防止上传 Shell）
    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
    }
    
    # 限制 xmlrpc.php 访问（防止暴力破解）
    location = /xmlrpc.php {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # 禁止访问 WordPress 安装和升级文件
    location ~* ^/(wp-admin/install|wp-admin/upgrade)\.php$ {
        deny all;
    }
    
    # ========================================================================
    # 性能优化
    # ========================================================================
    
    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript 
               application/json application/javascript application/xml+rss 
               application/rss+xml font/truetype font/opentype 
               application/vnd.ms-fontobject image/svg+xml;
    
    # 客户端上传限制
    client_max_body_size 64M;
    client_body_timeout 60s;
    
    # 禁止日志记录 favicon 和 robots.txt
    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }
    
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }
}

