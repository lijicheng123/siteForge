# ============================================================================
# Nginx 虚拟主机配置 - WordPress 优化版 (HTTP Only)
# ============================================================================
# 域名: {{ site_domain }}
# 文档根目录: {{ wordpress_install_dir }}
# 生成时间: {{ ansible_date_time.iso8601 }}
# 由 SiteForge 自动生成 - 请勿手动编辑
# ============================================================================

# HTTP Server Block (端口 80)
server {
    listen 80;
    listen [::]:80;
    
    server_name {{ site_domain }} www.{{ site_domain }};
    
    root {{ wordpress_install_dir }};
    index index.php index.html index.htm;
    
    # 访问日志和错误日志
    access_log /var/log/nginx/{{ site_domain }}/access.log;
    error_log /var/log/nginx/{{ site_domain }}/error.log warn;
    
    # 字符集
    charset utf-8;
    
    # ========================================================================
    # 安全头部配置
    # ========================================================================
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    
    # ========================================================================
    # Let's Encrypt ACME Challenge 目录（用于 SSL 证书申请）
    # 注意：使用独立的 webroot 目录，与 WordPress 文件分离
    # ========================================================================
    location ^~ /.well-known/acme-challenge/ {
        allow all;
        root /var/www/letsencrypt;
        default_type "text/plain";
        try_files $uri =404;
    }
    
    # ========================================================================
    # WordPress 永久链接支持
    # ========================================================================
    location / {
        try_files $uri $uri/ /index.php?$args;
    }
    
    # ========================================================================
    # PHP 处理配置 (FastCGI)
    # ========================================================================
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        
        # PHP-FPM Unix Socket 连接
        fastcgi_pass unix:/run/php-fpm/www.sock;
        fastcgi_index index.php;
        
        # FastCGI 参数
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        
        # 超时设置
        fastcgi_read_timeout 300;
        fastcgi_send_timeout 300;
        
        # 缓冲区设置
        fastcgi_buffer_size 128k;
        fastcgi_buffers 256 16k;
        fastcgi_busy_buffers_size 256k;
        fastcgi_temp_file_write_size 256k;
    }
    
    # ========================================================================
    # 静态文件缓存优化
    # ========================================================================
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # ========================================================================
    # WordPress 安全规则
    # ========================================================================
    
    # 禁止访问 wp-config.php
    location ~* wp-config.php {
        deny all;
    }
    
    # 禁止访问 .htaccess 和 .htpasswd
    location ~ /\.ht {
        deny all;
    }
    
    # 禁止访问隐藏文件（以 . 开头的文件）
    # 注意：排除 .well-known 目录（Let's Encrypt 需要访问）
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # 禁止访问 readme.html、license.txt 等敏感文件
    location ~* ^/(readme|license|changelog)\.(html|txt|md)$ {
        deny all;
    }
    
    # 禁止访问 wp-includes 目录中的 PHP 文件
    location ~* ^/wp-includes/.*\.php$ {
        deny all;
    }
    
    # 禁止访问 wp-content/uploads 目录中的 PHP 文件（防止上传 Shell）
    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
    }
    
    # 限制 xmlrpc.php 访问（防止暴力破解）
    location = /xmlrpc.php {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # 禁止访问 WordPress 安装和升级文件
    location ~* ^/(wp-admin/install|wp-admin/upgrade)\.php$ {
        deny all;
    }
    
    # ========================================================================
    # 性能优化
    # ========================================================================
    
    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript 
               application/json application/javascript application/xml+rss 
               application/rss+xml font/truetype font/opentype 
               application/vnd.ms-fontobject image/svg+xml;
    
    # 客户端上传限制
    client_max_body_size 64M;
    client_body_timeout 60s;
    
    # 禁止日志记录 favicon 和 robots.txt
    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }
    
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }
}

