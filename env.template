# Server Configuration
PORT=3000
HOST=0.0.0.0

# API Keys (必需 - 替换为你的真实密钥)

# 寰渡科技网关密钥 (默认使用) - 每个模型使用不同的密钥
DEV_CLUADE_API_KEY=your_claude_huandu_key_here
DEV_GEMMINI_API_KEY=your_gemini_huandu_key_here
DEV_OPENAI_API_KEY=your_openai_huandu_key_here

# 官方 API 密钥 (可选 - 仅在指定 channel='official' 时使用)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Google 官方推荐命名
GEMINI_API_KEY=your_gemini_api_key_here
# 兼容旧命名（可选）
GOOGLE_API_KEY=

# Environment
NODE_ENV=development

# 模型默认配置
DEFAULT_MAX_TOKENS_CLAUDE=4096
DEFAULT_MAX_TOKENS_GPT=4096
DEFAULT_MAX_TOKENS_GEMINI=4096
